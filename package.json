{
  "name": "trade-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Trade Flow full-stack monorepo with Next.js frontend, NestJS backend, and Supabase database",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start:prod",
    "start:frontend": "npm --prefix frontend run start",
    "start": "npm --prefix frontend run start",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "trade-flow",
    "nextjs",
    "nestjs",
    "supabase",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
